# Server
PORT=4000
NODE_ENV=development

# MongoDB. Leave empty in development to auto-start an in-memory MongoDB instance
# (via mongodb-memory-server) so the app runs with zero setup.
# For production / persistent data, set a real connection string, e.g.:
#   mongodb://127.0.0.1:27017/doctor-tracker
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/doctor-tracker
MONGODB_URI=

# Auth
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Seeded admin account (used by `npm run seed`)
ADMIN_EMAIL=admin@doctortracker.com
ADMIN_PASSWORD=ChangeMe123!

# CORS - the frontend origin allowed to call this API with credentials
CLIENT_ORIGIN=http://localhost:3000
